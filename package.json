{
  "name": "button-trpc-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --config client/vite.config.ts",
    "start:server": "tsx server/index.ts"
  },
  "dependencies": {
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "cors": "^2.8.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.1.0"
  }
}
